# Email settings (Gmail example — use an App Password, not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# How often to check for tee times (cron expression)
# Default: every 5 minutes
CHECK_INTERVAL=*/5 * * * *

# Number of days ahead to look for tee times (1–14)
DAYS_AHEAD=7
