# Telegram bot credentials
# See README for how to create a bot and find your chat ID
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNooP
TELEGRAM_CHAT_ID=987654321

# How often to check for tee times (cron expression)
# Default: every 5 minutes
CHECK_INTERVAL=*/5 * * * *

# Number of days ahead to look for tee times (1–14)
DAYS_AHEAD=7
